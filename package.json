{
  "name": "pesel-tools",
  "version": "0.15.5",
  "scripts": {
    "ng": "ng",
    "start": "ng serve",
    "start:open": "ng serve -o",
    "build": "ng build",
    "watch": "ng build --watch --configuration development",
    "test": "vitest",
    "typecheck:worker": "tsc --project tsconfig.worker.json --noEmit",
    "test:ui": "vitest --ui",
    "test:coverage": "vitest run --coverage",
    "start:ssr": "node dist/pesel-tools/server/server.mjs",
    "serve:ssr:pesel-tools": "node dist/pesel-tools/server/server.mjs",
    "lint": "ng lint",
    "release": "commit-and-tag-version",
    "e2e": "ng e2e",
    "cypress:open": "cypress open",
    "cypress:run": "cypress run",
    "lint:css": "stylelint \"src/**/*.css\"",
    "lint:css:fix": "stylelint \"src/**/*.css\" --fix"
  },
  "private": true,
  "license": "MIT",
  "dependencies": {
    "@angular/animations": "^22.1.6",
    "@angular/common": "^22.1.6",
    "@angular/compiler": "^22.1.6",
    "@angular/core": "^22.1.6",
    "@angular/forms": "^22.1.6",
    "@angular/platform-browser": "^22.1.6",
    "@angular/platform-browser-dynamic": "^22.1.6",
    "@angular/platform-server": "^22.1.6",
    "@angular/router": "^22.1.6",
    "@angular/service-worker": "^22.1.6",
    "@angular/ssr": "^22.1.8",
    "@eslint/js": "^9.32.0",
    "express": "^5.1.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular-eslint/builder": "^22.5.0",
    "@angular/build": "^22.1.8",
    "@angular/cli": "^22.1.8",
    "@angular/compiler-cli": "^22.1.6",
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@cypress/schematic": "^3.0.0",
    "@tailwindcss/postcss": "^4.3.3",
    "@testing-library/angular": "^19.5.0",
    "@testing-library/jest-dom": "^6.6.4",
    "@types/cookie-parser": "^1.4.8",
    "@types/express": "^5.0.1",
    "@types/node": "^20.17.19",
    "@vitest/coverage-v8": "^4.1.4",
    "@vitest/ui": "^4.0.12",
    "angular-eslint": "^22.5.0",
    "cypress": "latest",
    "eslint": "^9.28.0",
    "husky": "^8.0.0",
    "jsdom": "^27.1.0",
    "lint-staged": "^16.1.2",
    "postcss": "^8.5.28",
    "prettier": "^3.6.2",
    "stylelint": "^16.22.0",
    "stylelint-config-standard": "^38.0.0",
    "tailwindcss": "^4.3.3",
    "tsconfig-paths": "^4.2.0",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.33.1",
    "vite": "^7.2.6",
    "vitest": "^4.0.8"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix"
    ],
    "*.css": [
      "stylelint --fix"
    ],
    "*.{ts,js,css,json,html,md}": [
      "prettier --write"
    ]
  },
  "type": "module"
}
